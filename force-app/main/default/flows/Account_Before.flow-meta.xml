<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>DEBUG_Print</name>
        <label>DEBUG Print</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_TextField</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_TextField</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Parent.Rating</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_TextField</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Rating</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Rating_not_set</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_default_Rating</name>
        <label>Set default Rating</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Rating</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cold</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Rating_from_Parent</name>
        <label>Set Rating from Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Rating</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Parent.Rating</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>DEBUG_Print</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Rating_to_Hot</name>
        <label>Set Rating to Hot</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Rating</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hot</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Parent_linked</name>
        <label>Is Parent linked?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DEBUG_Print</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Parent is not linked</defaultConnectorLabel>
        <rules>
            <name>Yes_and_Parent_has_Rating</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Rating</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Rating_from_Parent</targetReference>
            </connector>
            <label>Yes, and Parent has Rating</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Rating_not_set</name>
        <label>Is Rating not set?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Rating was set</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.BillingState</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mazowieckie</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Rating_to_Hot</targetReference>
            </connector>
            <label>Yes, and State is Mazowieckie</label>
        </rules>
        <rules>
            <name>Yes_Rating_in_blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_default_Rating</targetReference>
            </connector>
            <label>Yes, Rating in blank</label>
        </rules>
    </decisions>
    <description>Presentation</description>
    <environments>Default</environments>
    <interviewLabel>Account Before Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Before</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Parent_linked</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>var_TextField</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
